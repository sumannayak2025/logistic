{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "logisticprojectdatafactory"
		},
		"Is_logistic_adb_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'Is_logistic_adb'"
		},
		"Is_logistic_azure_sql_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Is_logistic_azure_sql_db'"
		},
		"Is_logistic_adb_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0808-103329-max9o7fm"
		},
		"Is_logistic_azure_sql_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "project2devserver.database.windows.net"
		},
		"Is_logistic_azure_sql_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "projectdevsqldb"
		},
		"Is_logistic_azure_sql_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "user"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "logisticprojectdatafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Is_logistic_adb_accessToken": {
						"value": "[parameters('Is_logistic_adb_accessToken')]"
					},
					"Is_logistic_azure_sql_db_password": {
						"value": "[parameters('Is_logistic_azure_sql_db_password')]"
					},
					"Is_logistic_adb_properties_typeProperties_existingClusterId": {
						"value": "[parameters('Is_logistic_adb_properties_typeProperties_existingClusterId')]"
					},
					"Is_logistic_azure_sql_db_properties_typeProperties_server": {
						"value": "[parameters('Is_logistic_azure_sql_db_properties_typeProperties_server')]"
					},
					"Is_logistic_azure_sql_db_properties_typeProperties_database": {
						"value": "[parameters('Is_logistic_azure_sql_db_properties_typeProperties_database')]"
					},
					"Is_logistic_azure_sql_db_properties_typeProperties_userName": {
						"value": "[parameters('Is_logistic_azure_sql_db_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}