{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "logisticprojectdatafactory"
		},
		"Is_logistic_adb_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'Is_logistic_adb'"
		},
		"Is_logistic_azure_sql_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Is_logistic_azure_sql_db'"
		},
		"Is_logistic_adb_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0808-103329-max9o7fm"
		},
		"Is_logistic_azure_sql_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "project2devserver.database.windows.net"
		},
		"Is_logistic_azure_sql_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "projectdevsqldb"
		},
		"Is_logistic_azure_sql_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "user"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Is_logistic_adb')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "https://adb-7405605053821804.4.azuredatabricks.net",
					"accessToken": {
						"type": "SecureString",
						"value": "[parameters('Is_logistic_adb_accessToken')]"
					},
					"existingClusterId": "[parameters('Is_logistic_adb_properties_typeProperties_existingClusterId')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Is_logistic_azure_sql_db')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('Is_logistic_azure_sql_db_properties_typeProperties_server')]",
					"database": "[parameters('Is_logistic_azure_sql_db_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('Is_logistic_azure_sql_db_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('Is_logistic_azure_sql_db_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_logistic_data_process')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Act-Notebook-Execute-Load-Bronze-Initial-Full-Load",
						"type": "DatabricksNotebook",
						"dependsOn": [],
						"policy": {
							"timeout": "0.00:15:00",
							"retry": 1,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Users/sumannayak.sn1995@gmail.com/sumannayak.sn1995@gmail.com/Load_Bronze_Initial_Full_Load",
							"baseParameters": {
								"masterPipelineRunID": {
									"value": "@pipeline().parameters.P_Master_Pipeline_Run_Id",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "Is_logistic_adb",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Act-Notebook-Execute-Bronze-To-Silver",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Act-Notebook-Execute-Load-Bronze-Initial-Full-Load",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.00:15:00",
							"retry": 1,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Users/sumannayak.sn1995@gmail.com/sumannayak.sn1995@gmail.com/Bronze _To_Silver",
							"baseParameters": {
								"masterPipelineRunID": {
									"value": "@pipeline().parameters.P_Master_Pipeline_Run_Id",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "Is_logistic_adb",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "Act-Notebook-Execute-Silver-To-Gold",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Act-Notebook-Execute-Bronze-To-Silver",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.00:15:00",
							"retry": 1,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Users/sumannayak.sn1995@gmail.com/sumannayak.sn1995@gmail.com/Silver_To_Gold ",
							"baseParameters": {
								"masterPipelineRunID": {
									"value": "@pipeline().parameters.P_Master_Pipeline_Run_Id",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "Is_logistic_adb",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"P_Master_Pipeline_Run_Id": {
						"type": "string"
					}
				},
				"folder": {
					"name": "csv_files_data_process"
				},
				"annotations": [],
				"lastPublishTime": "2026-08-12T14:17:01Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Is_logistic_adb')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Is_logistic_azure_sql')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Is_logistic_azure_sql_db",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Is_logistic_azure_sql_db')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_logistic_master_data_process')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Act-Set-Pipeline-Start-Time",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "V_Pipeline_Start_time",
							"value": {
								"value": "@utcNow()",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Act-Set-Master-Pipeline-Run-Id",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "V_Master_Pipeline_Run_Id",
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Act-Lookup-Get-is-Last-Run-Completed-Status",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "Act-Set-Pipeline-Start-Time",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Act-Set-Master-Pipeline-Run-Id",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.00:10:00",
							"retry": 1,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select is_last_run_completed from METADATA.pipeline_run_status where pipeline_name = '@{pipeline().Pipeline}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "Is_logistic_azure_sql",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "Act-Is-last-Run-Completed",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Act-Lookup-Get-is-Last-Run-Completed-Status",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@equals(activity('Act-Lookup-Get-is-Last-Run-Completed-Status'). output.firstRow.is_last_run_completed,true)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Act-Script-Update-Is-last-Run-Completed-Flag-To-0",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.00:10:00",
										"retry": 1,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "Is_logistic_azure_sql_db",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "UPDATE METADATA.pipeline_run_status SET is_last_run_completed = 0 WHERE pipeline_name = '@{pipeline().Pipeline}'",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "Act-Procedure-Log-Pipeline-Audit",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [
										{
											"activity": "Act-Execute-PL-Data-process",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "[[metadata].[SP_INSERT_PIPELINE_AUDIT_LOG]",
										"storedProcedureParameters": {
											"PIPELINE_END_TIME": {
												"value": {
													"value": "@utcNow()",
													"type": "Expression"
												},
												"type": "DateTime"
											},
											"PIPELINE_NAME": {
												"value": {
													"value": "@pipeline().Pipeline",
													"type": "Expression"
												},
												"type": "String"
											},
											"PIPELINE_RUN_ID": {
												"value": {
													"value": "@variables('V_Master_Pipeline_Run_Id')",
													"type": "Expression"
												},
												"type": "String"
											},
											"PIPELINE_START_TIME": {
												"value": {
													"value": "@variables('V_Pipeline_Start_time')",
													"type": "Expression"
												},
												"type": "DateTime"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "Is_logistic_azure_sql_db",
										"type": "LinkedServiceReference"
									}
								},
								{
									"name": "Act-Script-Update-Is-last-Run-Completed-Flag-To-1",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "Act-Procedure-Log-Pipeline-Audit",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.00:10:00",
										"retry": 1,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "Is_logistic_azure_sql_db",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "UPDATE METADATA.pipeline_run_status SET is_last_run_completed = 1 WHERE pipeline_name = '@{pipeline().Pipeline}'",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "Act-Execute-PL-Data-process",
									"type": "ExecutePipeline",
									"dependsOn": [
										{
											"activity": "Act-Script-Update-Is-last-Run-Completed-Flag-To-0",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "pl_logistic_data_process",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"P_Master_Pipeline_Run_Id": {
												"value": "@variables('V_Master_Pipeline_Run_Id')",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"V_Pipeline_Start_time": {
						"type": "String"
					},
					"V_Master_Pipeline_Run_Id": {
						"type": "String"
					}
				},
				"folder": {
					"name": "csv_files_data_process"
				},
				"annotations": [],
				"lastPublishTime": "2026-08-12T14:17:01Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/Is_logistic_azure_sql')]",
				"[concat(variables('factoryId'), '/linkedServices/Is_logistic_azure_sql_db')]",
				"[concat(variables('factoryId'), '/pipelines/pl_logistic_data_process')]"
			]
		}
	]
}